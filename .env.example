# Web browser-safe values
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only: pairing and agent API authentication. Never prefix NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Optional public URL shown by local development tooling
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Agent (normally entered by `relaydesk-agent pair`)
RELAYDESK_API_URL=http://localhost:3000
RELAYDESK_SYNC_INTERVAL=30
RELAYDESK_HEARTBEAT_INTERVAL=30
